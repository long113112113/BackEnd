meta {
  name: Create Device Key
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/device-keys
  body: json
  auth: none
}

headers {
  Cookie: token={{token}}
  Content-Type: application/json
}

body:json {
  {
    "device_id": "ESP32_TEST_001",
    "hmac_key": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  }
}
