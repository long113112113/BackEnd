meta {
  name: Create Device Keys Batch
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/device-keys/batch
  body: json
  auth: none
}

headers {
  Cookie: token={{token}}
  Content-Type: application/json
}

body:json {
  {
    "keys": "ESP32_DEV1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef,ESP32_DEV2:fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"
  }
}
