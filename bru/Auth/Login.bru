meta {
  name: Login Admin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "admin123"
  }
}

script:post-response {
  if (res.status === 200) {
    if (res.body && res.body.data && res.body.data.token) {
      bru.setEnvVar("token", res.body.data.token);
    }
  }
}
