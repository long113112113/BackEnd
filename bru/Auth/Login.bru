meta {
  name: Login Admin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "admin",
    "password": "admin123"
  }
}

script:post-response {
  if (res.status === 200) {
    const cookie = res.headers["set-cookie"];
    if (cookie) {
      const match = (Array.isArray(cookie) ? cookie[0] : cookie).match(/token=([^;]+)/);
      if (match) {
        bru.setEnvVar("token", match[1]);
      }
    }
  }
}
