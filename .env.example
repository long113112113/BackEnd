PORT=3000
NODE_ENV=development
# Cookie behavior: production sets Secure + SameSite=None, development sets SameSite=Lax (no Secure flag)
CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=your-jwt-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CSRF_SECRET=your-64-char-random-secret-here-abcdefghijklmnopqrstuvwxyz1234567890

# Minimum minutes between attendance scans for the same student (default: 3)
ATTENDANCE_COOLDOWN_MINUTES=3
