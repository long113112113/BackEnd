# Server
PORT=3000
NODE_ENV=development
TRUST_PROXY=false

# CORS - Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT - JWT_SECRET must be at least 32 characters in production
JWT_SECRET=your-jwt-secret-here-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CSRF - Must be a 64-character random string
CSRF_SECRET=your-64-char-random-secret-here-abcdefghijklmnopqrstuvwxyz1234567890

# MQTT Broker (Aedes embedded broker)
MQTT_PORT=1883
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_TOPIC_PREFIX=iot/attendance
MQTT_BROKER_URL=mqtt://localhost:1883

# MQTT Credentials - ESP32 devices
MQTT_USERNAME=esp32_device_user
MQTT_PASSWORD=esp32_device_password

# MQTT Credentials - Internal client
MQTT_INTERNAL_USERNAME=internal_client
MQTT_INTERNAL_PASSWORD=internal_client_password

# Redis (optional - falls back to in-memory nonce store if not set)
REDIS_URL=redis://localhost:6379

# Device HMAC Keys (optional - format: DEVICE_ID:HEX_KEY,DEVICE_ID2:HEX_KEY2)
DEVICE_HMAC_KEYS=

# Admin seed (optional - only seeds when users table is empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password-min-12-chars
ADMIN_FULLNAME=System Administrator

# Attendance settings
ATTENDANCE_COOLDOWN_MINUTES=3
